private struct HomePanel<Content: View, Decoration: View>: View {
    @Environment(\.colorScheme) private var colorScheme

    let accent: Color
    let decoration: Decoration?
    let content: Content

    init(accent: Color, @ViewBuilder content: () -> Content) where Decoration == EmptyView {
        self.accent = accent
        self.decoration = nil
        self.content = content()
    }

    init(accent: Color, @ViewBuilder decoration: () -> Decoration, @ViewBuilder content: () -> Content) {
        self.accent = accent
        self.decoration = decoration()
        self.content = content()
    }

    private var backgroundGradient: LinearGradient {
        LinearGradient(
            colors: [
                accent.opacity(colorScheme == .dark ? 0.18 : 0.12),
                Color.white.opacity(colorScheme == .dark ? 0.04 : 0.78),
                Color.white.opacity(colorScheme == .dark ? 0.02 : 0.6)
            ],
            startPoint: .topLeading,
            endPoint: .bottomTrailing
        )
    }

    private var borderColor: Color {
        Color.white.opacity(colorScheme == .dark ? 0.08 : 0.32)
    }

    var body: some View {
        ZStack(alignment: .topTrailing) {
            RoundedRectangle(cornerRadius: 26, style: .continuous)
                .fill(backgroundGradient)
                .overlay(
                    RoundedRectangle(cornerRadius: 26, style: .continuous)
                        .stroke(borderColor, lineWidth: 1)
                )

            if let decoration {
                decoration
                    .clipShape(RoundedRectangle(cornerRadius: 26, style: .continuous))
            }

            VStack(alignment: .leading, spacing: 12) {
                content
            }
            .frame(maxWidth: .infinity, alignment: .leading)
            .padding(18)
        }
        .shadow(
            color: accent.opacity(colorScheme == .dark ? 0.22 : 0.12),
            radius: 14,
            x: 0,
            y: 8
        )
    }
}

private struct HomePanelIcon: View {
    @Environment(\.colorScheme) private var colorScheme

    let systemName: String
    let accent: Color

    var body: some View {
        ZStack {
